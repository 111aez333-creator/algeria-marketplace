rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ لازم يبقى مطابق تماماً لـ ADMIN_EMAIL فـ admin.js.
    // إذا بدّلت الإيميل فـ admin.js، بدّلو هنا زيد.
    function primaryAdminEmail() { return '111aez333@gmail.com'; }

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isPrimaryAdmin() { return isAuth() && request.auth.token.email == primaryAdminEmail(); }
    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isParticipant(convId) {
      return isAuth() && exists(/databases/$(database)/documents/conversations/$(convId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    // ===================== USERS =====================
    match /users/{uid} {
      allow read: if isAuth();

      // إنشاء الملف الشخصي: مستخدم عادي (role:'user'), أو الأدمن الأساسي عند أول دخول للوحة الإدارة (role:'admin').
      allow create: if isOwner(uid) && request.resource.data.uid == uid && (
        request.resource.data.role == 'user' ||
        (isPrimaryAdmin() && request.resource.data.role == 'admin')
      );

      allow update: if isAdmin() || (
        // ترقية ذاتية لحساب الأدمن الأساسي فقط (admin.js: يبدّل role فقط عند أول دخول)
        isOwner(uid) && isPrimaryAdmin() &&
        resource.data.role != 'admin' && request.resource.data.role == 'admin' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','updatedAt'])
      ) || (
        // تعديل الملف الشخصي العادي: البائع ما يقدرش يبدّل role/verified/banned بروحو
        isOwner(uid) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.verified == resource.data.verified &&
        request.resource.data.banned == resource.data.banned &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName','email','photoURL','favoriteIds','phone','wilaya','commune','updatedAt'])
      );

      allow delete: if isAdmin();
    }

    // ===================== LISTINGS =====================
    match /listings/{id} {
      allow read: if true;

      allow create: if isAuth() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status in ['published','pending'] &&
        request.resource.data.views == 0 &&
        request.resource.data.ratingCount == 0 &&
        request.resource.data.ratingSum == 0;

      allow update: if isAdmin() || (
        // المالك يبدّل محتوى الإعلان (ماشي الحالة، ماشي المشاهدات، ماشي التقييم)
        isAuth() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.views == resource.data.views &&
        request.resource.data.ratingCount == resource.data.ratingCount &&
        request.resource.data.ratingSum == resource.data.ratingSum &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','price','category','wilaya','city','condition','delivery',
          'images','image','description','phone','showPhone','updatedAt'
        ])
      ) || (
        // أي مستخدم مسجّل يقدر يزيد المشاهدات بواحد فقط (openListing)
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views','updatedAt']) &&
        request.resource.data.views == resource.data.views + 1
      ) || (
        // أي مستخدم غير صاحب الإعلان يقدر يضيف تقييم واحد (⭐1 إلى ⭐5)
        isAuth() && resource.data.ownerUid != request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingCount','ratingSum','updatedAt']) &&
        request.resource.data.ratingCount == resource.data.ratingCount + 1 &&
        request.resource.data.ratingSum >= resource.data.ratingSum + 1 &&
        request.resource.data.ratingSum <= resource.data.ratingSum + 5
      );

      allow delete: if isAdmin() || (isAuth() && resource.data.ownerUid == request.auth.uid);

      // تعليقات التقييم (subcollection مربوطة بكل إعلان)
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuth() &&
          request.resource.data.raterUid == request.auth.uid &&
          get(/databases/$(database)/documents/listings/$(id)).data.ownerUid != request.auth.uid &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
        allow update: if false;
        allow delete: if isAdmin() || (isAuth() && resource.data.raterUid == request.auth.uid);
      }
    }

    // ===================== DRIVERS =====================
    match /drivers/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'pending' && request.resource.data.verified == false;
      allow update: if isAdmin() || (isAuth() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.verified == resource.data.verified &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activityStatus','lastSeenAt','updatedAt']));
      allow delete: if isAdmin();
    }

    // ===================== CONVERSATIONS / MESSAGES =====================
    match /conversations/{id} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      allow update: if isAdmin() || (isAuth() && request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants);
    }

    match /conversations/{id}/messages/{msg} {
      allow read: if isParticipant(id);
      allow create: if isParticipant(id) && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isParticipant(id) && resource.data.senderUid == request.auth.uid);
    }

    // ===================== BLOCKS =====================
    // doc id: `${blockerUid}_${blockedUid}` — الحقول: blockerUid, blockedUid, targetName
    match /blocks/{id} {
      allow read: if isAuth() && resource.data.blockerUid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.blockerUid == request.auth.uid &&
        request.resource.data.blockedUid != request.auth.uid;
      allow delete: if isAuth() && resource.data.blockerUid == request.auth.uid;
    }

    // ===================== REPORTS =====================
    match /reports/{id} {
      allow create: if isAuth() && request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.status == 'open';
      allow read, delete: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
    }

    // ===================== DELIVERY REQUESTS =====================
    // الحقول: listingId, listingTitle, sellerUid, buyerUid, buyerName, phone, wilaya, city,
    // address, idCardUrl, selfieUrl, location, driverId, status
    match /deliveryRequests/{id} {
      allow read: if isAdmin() || (isAuth() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        resource.data.driverId == request.auth.uid));

      allow create: if isAuth() &&
        request.resource.data.buyerUid == request.auth.uid &&
        request.resource.data.status == 'pending_review' &&
        request.resource.data.driverId == null;

      allow update: if isAdmin() || (
        // الموصّل المعيّن يبدّل الحالة برك عبر مراحل التوصيل
        isAuth() && resource.data.driverId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) &&
        request.resource.data.status in ['picked_up','delivering','completed']
      );

      allow delete: if isAdmin();
    }

    // ===================== PROMOTIONS =====================
    match /promotions/{id} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ===================== NOTIFICATIONS (للاستعمال المستقبلي عبر Cloud Functions) =====================
    match /notifications/{id} {
      allow read: if isAuth() && resource.data.toUserId == request.auth.uid;
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuth() && resource.data.toUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin() || (isAuth() && resource.data.toUserId == request.auth.uid);
    }
  }
}
